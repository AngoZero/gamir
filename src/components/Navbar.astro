---
import { Sun, Moon } from "lucide-astro";
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500"
>
  <!-- Barra de progreso de scroll -->
  <div
    id="scroll-progress"
    class="absolute top-0 left-0 h-1 bg-gradient-to-r from-amber-200 via-rose-300 to-amber-300 transition-all duration-300 shadow-lg shadow-amber-200/50"
    style="width: 0%; background: linear-gradient(90deg, #E0BFB8 0%, #D4AF37 50%, #E0BFB8 100%)"
  >
  </div>

  <div class="absolute inset-0 bg-white/95 dark:bg-neutral-950/98 backdrop-blur-xl border-b border-rose-300/30 dark:border-amber-200/20 transition-colors duration-300">
  </div>

  <!-- Efectos de fondo animados -->
  <div class="absolute inset-0 overflow-hidden opacity-10">
    <div
      class="absolute w-32 h-32 rounded-full blur-3xl animate-float"
      style="top: -50%; left: 10%; background: #E0BFB8;"
    >
    </div>
    <div
      class="absolute w-32 h-32 rounded-full blur-3xl animate-float-delayed"
      style="top: -50%; right: 10%; background: #D4AF37;"
    >
    </div>
  </div>

  <div class="container mx-auto px-6 py-4 relative z-10">
    <div class="flex items-center justify-between">
      <!-- Logo Premium -->
      <div class="flex items-center group cursor-pointer">
        <a href="#home" class="flex items-center space-x-3">
          <!-- Logo con efecto 3D -->
          <div class="relative">
            <div
              class="absolute inset-0 rounded-xl blur-md opacity-75 group-hover:opacity-100 transition-opacity"
              style="background: linear-gradient(135deg, #E0BFB8, #D4AF37);"
            >
            </div>
            <div
              class="relative w-12 h-12 rounded-xl flex items-center justify-center transform group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-2xl"
              style="background: linear-gradient(135deg, #E0BFB8, #D4AF37); box-shadow: 0 10px 40px rgba(224, 191, 184, 0.4);"
            >
              <span class="text-white dark:text-neutral-950 font-black text-2xl">G</span>
            </div>
          </div>
          <!-- Texto del logo -->
          <div class="flex flex-col">
            <span
              class="text-2xl font-black tracking-wider group-hover:tracking-widest transition-all duration-300"
              style="background: linear-gradient(90deg, #E0BFB8, #D4AF37, #E0BFB8); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
            >
              GAMIR
            </span>
            <span class="text-[8px] tracking-[0.2em] uppercase font-semibold" style="color: #D4AF37;">
              SALON
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-2">
        <a
          href="#home"
          class="nav-link group relative px-5 py-2.5 overflow-hidden"
          data-section="home"
        >
          <span
            class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"
            style="background: linear-gradient(90deg, transparent 0%, rgba(224, 191, 184, 0.15) 50%, transparent 100%);"
          >
          </span>
          <span
            class="relative z-10 text-gray-700 dark:text-neutral-300 hover:text-rose-gold-500 dark:hover:text-rose-gold-400 transition-colors duration-300 font-semibold"
          >
            Inicio
          </span>
        </a>
        <a
          href="#about"
          class="nav-link group relative px-5 py-2.5 overflow-hidden"
          data-section="about"
        >
          <span
            class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"
            style="background: linear-gradient(90deg, transparent 0%, rgba(224, 191, 184, 0.15) 50%, transparent 100%);"
          >
          </span>
          <span
            class="relative z-10 text-gray-700 dark:text-neutral-300 hover:text-rose-gold-500 dark:hover:text-rose-gold-400 transition-colors duration-300 font-semibold"
          >
            Nosotros
          </span>
        </a>
        <a
          href="#services"
          class="nav-link group relative px-5 py-2.5 overflow-hidden"
          data-section="services"
        >
          <span
            class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"
            style="background: linear-gradient(90deg, transparent 0%, rgba(224, 191, 184, 0.15) 50%, transparent 100%);"
          >
          </span>
          <span
            class="relative z-10 text-gray-700 dark:text-neutral-300 hover:text-rose-gold-500 dark:hover:text-rose-gold-400 transition-colors duration-300 font-semibold"
          >
            Servicios
          </span>
        </a>
        <a
          href="#contact"
          class="nav-link group relative px-5 py-2.5 overflow-hidden"
          data-section="contact"
        >
          <span
            class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"
            style="background: linear-gradient(90deg, transparent 0%, rgba(224, 191, 184, 0.15) 50%, transparent 100%);"
          >
          </span>
          <span
            class="relative z-10 text-gray-700 dark:text-neutral-300 hover:text-rose-gold-500 dark:hover:text-rose-gold-400 transition-colors duration-300 font-semibold"
          >
            Contacto
          </span>
        </a>
        <a
          href="#location"
          class="nav-link group relative px-5 py-2.5 overflow-hidden"
          data-section="location"
        >
          <span
            class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"
            style="background: linear-gradient(90deg, transparent 0%, rgba(224, 191, 184, 0.15) 50%, transparent 100%);"
          >
          </span>
          <span
            class="relative z-10 text-gray-700 dark:text-neutral-300 hover:text-rose-gold-500 dark:hover:text-rose-gold-400 transition-colors duration-300 font-semibold"
          >
            Ubicación
          </span>
        </a>

        <button
          id="theme-toggle"
          class="relative w-11 h-11 rounded-xl flex items-center justify-center group transition-all duration-300 ml-4 bg-rose-gold-100 dark:bg-rose-gold-900/20 border-2 border-rose-gold-300 dark:border-rose-gold-500/30 hover:bg-rose-gold-200 dark:hover:bg-rose-gold-900/30"
          aria-label="Cambiar tema"
        >
          <Sun
            id="sun-icon"
            class="w-5 h-5 absolute transition-all duration-300 text-rose-gold-600 dark:text-rose-gold-400"
          />
          <Moon
            id="moon-icon"
            class="w-5 h-5 absolute transition-all duration-300 opacity-0 scale-0 text-rose-gold-600 dark:text-rose-gold-400"
          />
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden relative w-12 h-12 rounded-xl border-2 transition-all flex items-center justify-center group bg-rose-gold-100 dark:bg-rose-gold-900/20 border-rose-gold-300 dark:border-rose-gold-500/30"
        aria-label="Abrir menú"
      >
        <div class="w-6 h-5 flex flex-col justify-between">
          <span
            id="menu-line-1"
            class="w-full h-0.5 transform transition-all duration-300 bg-rose-gold-600 dark:bg-rose-gold-400"
          ></span>
          <span
            id="menu-line-2"
            class="w-full h-0.5 transform transition-all duration-300 bg-rose-gold-600 dark:bg-rose-gold-400"
          ></span>
          <span
            id="menu-line-3"
            class="w-full h-0.5 transform transition-all duration-300 bg-rose-gold-600 dark:bg-rose-gold-400"
          ></span>
        </div>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="hidden md:hidden mt-4 pt-4 border-t border-rose-300/30 dark:border-rose-300/20"
    >
      <div class="flex flex-col space-y-1">
        <a
          href="#home"
          class="nav-link-mobile group relative px-5 py-3.5 rounded-lg overflow-hidden"
          data-section="home"
        >
          <span
            class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"
            style="background: linear-gradient(90deg, transparent 0%, rgba(224, 191, 184, 0.15) 50%, transparent 100%);"
          >
          </span>
          <span
            class="relative z-10 text-gray-700 dark:text-gray-300 group-hover:text-rose-gold-500 dark:group-hover:text-rose-gold-400 transition-colors font-medium"
          >
            Inicio
          </span>
        </a>
        <a
          href="#about"
          class="nav-link-mobile group relative px-5 py-3.5 rounded-lg overflow-hidden"
          data-section="about"
        >
          <span
            class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"
            style="background: linear-gradient(90deg, transparent 0%, rgba(224, 191, 184, 0.15) 50%, transparent 100%);"
          >
          </span>
          <span
            class="relative z-10 text-gray-700 dark:text-gray-300 group-hover:text-rose-gold-500 dark:group-hover:text-rose-gold-400 transition-colors font-medium"
          >
            Nosotros
          </span>
        </a>
        <a
          href="#services"
          class="nav-link-mobile group relative px-5 py-3.5 rounded-lg overflow-hidden"
          data-section="services"
        >
          <span
            class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"
            style="background: linear-gradient(90deg, transparent 0%, rgba(224, 191, 184, 0.15) 50%, transparent 100%);"
          >
          </span>
          <span
            class="relative z-10 text-gray-700 dark:text-gray-300 group-hover:text-rose-gold-500 dark:group-hover:text-rose-gold-400 transition-colors font-medium"
          >
            Servicios
          </span>
        </a>
        <a
          href="#contact"
          class="nav-link-mobile group relative px-5 py-3.5 rounded-lg overflow-hidden"
          data-section="contact"
        >
          <span
            class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"
            style="background: linear-gradient(90deg, transparent 0%, rgba(224, 191, 184, 0.15) 50%, transparent 100%);"
          >
          </span>
          <span
            class="relative z-10 text-gray-700 dark:text-gray-300 group-hover:text-rose-gold-500 dark:group-hover:text-rose-gold-400 transition-colors font-medium"
          >
            Contacto
          </span>
        </a>
        <a
          href="#location"
          class="nav-link-mobile group relative px-5 py-3.5 rounded-lg overflow-hidden"
          data-section="location"
        >
          <span
            class="absolute inset-0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"
            style="background: linear-gradient(90deg, transparent 0%, rgba(224, 191, 184, 0.15) 50%, transparent 100%);"
          >
          </span>
          <span
            class="relative z-10 text-gray-700 dark:text-gray-300 group-hover:text-rose-gold-500 dark:group-hover:text-rose-gold-400 transition-colors font-medium"
          >
            Ubicación
          </span>
        </a>

        <button
          id="theme-toggle-mobile"
          class="mt-3 group relative px-5 py-3.5 rounded-lg overflow-hidden flex items-center justify-between bg-rose-gold-100 dark:bg-rose-gold-900/20 border-2 border-rose-gold-300 dark:border-rose-gold-500/30 hover:bg-rose-gold-200 dark:hover:bg-rose-gold-900/30 transition-all"
          aria-label="Cambiar tema"
        >
          <span class="relative z-10 text-gray-700 dark:text-gray-300 font-medium">
            Cambiar tema
          </span>
          <div class="relative w-8 h-8 flex items-center justify-center">
            <Sun
              id="sun-icon-mobile"
              class="w-5 h-5 absolute transition-all duration-300 text-rose-gold-600 dark:text-rose-gold-400"
            />
            <Moon
              id="moon-icon-mobile"
              class="w-5 h-5 absolute transition-all duration-300 opacity-0 scale-0 text-rose-gold-600 dark:text-rose-gold-400"
            />
          </div>
        </button>
      </div>
    </div>
  </div>
</nav>

<style>
  /* Estado activo mejorado */
  .nav-link.active,
  .nav-link-mobile.active {
    position: relative;
  }

  .nav-link.active span:last-child,
  .nav-link-mobile.active span:last-child {
    color: #ec4899;
    font-weight: 700;
  }

  .nav-link.active::before,
  .nav-link-mobile.active::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(236, 72, 153, 0.12) 0%,
      rgba(236, 72, 153, 0.2) 100%
    );
    border-radius: 0.5rem;
    border: 1px solid rgba(236, 72, 153, 0.4);
    box-shadow: 0 0 30px rgba(236, 72, 153, 0.3),
      inset 0 0 20px rgba(236, 72, 153, 0.1);
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .nav-link.active::after {
    content: "";
    position: absolute;
    bottom: -12px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    background: linear-gradient(135deg, #f472b6 0%, #ec4899 100%);
    border-radius: 50%;
    box-shadow: 0 0 15px rgba(236, 72, 153, 1), 0 0 30px rgba(236, 72, 153, 0.5);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%,
    100% {
      box-shadow: 0 0 30px rgba(236, 72, 153, 0.3),
        inset 0 0 20px rgba(236, 72, 153, 0.1);
    }
    50% {
      box-shadow: 0 0 40px rgba(236, 72, 153, 0.5),
        inset 0 0 30px rgba(236, 72, 153, 0.2);
    }
  }

  @keyframes pulse-dot {
    0%,
    100% {
      transform: translateX(-50%) scale(1);
      box-shadow: 0 0 15px rgba(236, 72, 153, 1),
        0 0 30px rgba(236, 72, 153, 0.5);
    }
    50% {
      transform: translateX(-50%) scale(1.2);
      box-shadow: 0 0 20px rgba(236, 72, 153, 1),
        0 0 40px rgba(236, 72, 153, 0.7);
    }
  }

  /* Animaciones de entrada */
  #navbar {
    animation: slideDown 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Animaciones flotantes */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) translateX(0);
    }
    33% {
      transform: translateY(-20px) translateX(10px);
    }
    66% {
      transform: translateY(10px) translateX(-10px);
    }
  }

  .animate-float {
    animation: float 8s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float 8s ease-in-out infinite;
    animation-delay: 2s;
  }

  /* Navbar compacta al hacer scroll */
  #navbar.scrolled {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  #navbar.scrolled .container {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  /* Animación del menú móvil */
  #mobile-menu-button.active #menu-line-1 {
    transform: rotate(45deg) translateY(8px) translateX(6px);
  }

  #mobile-menu-button.active #menu-line-2 {
    opacity: 0;
    transform: translateX(20px);
  }

  #mobile-menu-button.active #menu-line-3 {
    transform: rotate(-45deg) translateY(-8px) translateX(6px);
  }
</style>

<script>
  // Mobile menu toggle
  const menuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  menuButton?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
    menuButton?.classList.toggle("active");
  });

  // Close mobile menu when clicking a link
  const mobileLinks = mobileMenu?.querySelectorAll("a");
  mobileLinks?.forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      menuButton?.classList.remove("active");
    });
  });

  // Smooth scroll for all anchor links
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener("click", function (e) {
      e.preventDefault();
      const target = document.querySelector(
        this.getAttribute("href") as string
      );
      if (target) {
        const navbarHeight = 80;
        const targetPosition =
          (target as HTMLElement).offsetTop - navbarHeight;
        window.scrollTo({
          top: targetPosition,
          behavior: "smooth",
        });
      }
    });
  });

  // Active section detection on scroll
  const sections = document.querySelectorAll("section[id]");
  const navLinks = document.querySelectorAll(".nav-link, .nav-link-mobile");

  function updateActiveLink() {
    let currentSection = "";
    const scrollPosition = window.scrollY + 150;

    sections.forEach((section) => {
      const sectionTop = (section as HTMLElement).offsetTop;
      const sectionHeight = (section as HTMLElement).offsetHeight;
      const sectionId = section.getAttribute("id");

      if (
        scrollPosition >= sectionTop &&
        scrollPosition < sectionTop + sectionHeight
      ) {
        currentSection = sectionId || "";
      }
    });

    navLinks.forEach((link) => {
      link.classList.remove("active");
      if (link.getAttribute("data-section") === currentSection) {
        link.classList.add("active");
      }
    });
  }

  // Update active link on scroll
  window.addEventListener("scroll", updateActiveLink);

  // Set initial active link
  updateActiveLink();

  // Scroll progress bar
  const scrollProgress = document.getElementById("scroll-progress");
  const navbar = document.getElementById("navbar");

  window.addEventListener("scroll", () => {
    const windowHeight = window.innerHeight;
    const documentHeight = document.documentElement.scrollHeight;
    const scrollTop = window.scrollY;
    const scrollPercent = (scrollTop / (documentHeight - windowHeight)) * 100;

    if (scrollProgress) {
      scrollProgress.style.width = scrollPercent + "%";
    }

    // Navbar effect on scroll
    if (navbar) {
      if (window.scrollY > 50) {
        navbar.classList.add("scrolled");
      } else {
        navbar.classList.remove("scrolled");
      }
    }
  });

  const themeToggle = document.getElementById("theme-toggle");
  const themeToggleMobile = document.getElementById("theme-toggle-mobile");
  const sunIcon = document.getElementById("sun-icon");
  const moonIcon = document.getElementById("moon-icon");
  const sunIconMobile = document.getElementById("sun-icon-mobile");
  const moonIconMobile = document.getElementById("moon-icon-mobile");
  const html = document.documentElement;

  function getTheme() {
    return localStorage.getItem("theme") || "dark";
  }

  function setTheme(theme: string) {
    localStorage.setItem("theme", theme);
    html.classList.remove("light", "dark");
    html.classList.add(theme);
    updateIcons(theme);
  }

  function updateIcons(theme: string) {
    if (theme === "light") {
      sunIcon?.classList.add("opacity-0", "scale-0");
      moonIcon?.classList.remove("opacity-0", "scale-0");
      sunIconMobile?.classList.add("opacity-0", "scale-0");
      moonIconMobile?.classList.remove("opacity-0", "scale-0");
    } else {
      sunIcon?.classList.remove("opacity-0", "scale-0");
      moonIcon?.classList.add("opacity-0", "scale-0");
      sunIconMobile?.classList.remove("opacity-0", "scale-0");
      moonIconMobile?.classList.add("opacity-0", "scale-0");
    }
  }

  function toggleTheme() {
    const currentTheme = getTheme();
    const newTheme = currentTheme === "dark" ? "light" : "dark";
    setTheme(newTheme);
  }

  setTheme(getTheme());

  themeToggle?.addEventListener("click", toggleTheme);
  themeToggleMobile?.addEventListener("click", toggleTheme);
</script>
