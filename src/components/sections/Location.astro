---
// Sección Location - Ubicación con Google Maps
import { MapPin, Clock, Phone, Navigation } from 'lucide-astro';
---

<section id="location" class="relative py-20 bg-gradient-to-b from-luxury-black-800 to-luxury-black-900 overflow-hidden">
  <!-- Efecto de fondo decorativo -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute top-20 left-10 w-64 h-64 bg-rose-gold-500 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-rose-gold-600 rounded-full blur-3xl"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <!-- Header -->
    <div class="max-w-4xl mx-auto text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-rose-gold-500 to-rose-gold-600 bg-clip-text text-transparent mb-6">
        Encuéntranos en Tampico
      </h2>
      <p class="text-lg text-gray-300">
        Estamos ubicados en el corazón de Tampico, listos para transformar tu estilo
      </p>
    </div>

    <!-- Contenido principal -->
    <div class="grid lg:grid-cols-5 gap-8">
      <!-- Información de contacto y ubicación -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Tarjeta de dirección -->
        <div class="group bg-gradient-to-br from-luxury-black-900/90 to-luxury-black-800/90 p-8 rounded-2xl border-2 border-rose-gold-500/30 hover:border-rose-gold-500/60 transition-all duration-300 backdrop-blur-sm shadow-2xl hover:shadow-rose-gold-500/20">
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-gradient-to-br from-rose-gold-500 to-rose-gold-600 rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                <MapPin class="w-7 h-7 text-luxury-black-900" />
              </div>
            </div>
            <div class="flex-1">
              <h4 class="text-xl font-bold text-rose-gold-500 mb-2">Nuestra Dirección</h4>
              <p class="text-gray-300 text-lg leading-relaxed">
                Emiliano Zapata 229<br />
                Colonia La Paz<br />
                Tampico, Tamaulipas<br />
                CP 89326, México
              </p>
            </div>
          </div>
        </div>

        <!-- Tarjeta de horario -->
        <div class="group bg-gradient-to-br from-luxury-black-900/90 to-luxury-black-800/90 p-8 rounded-2xl border-2 border-rose-gold-500/30 hover:border-rose-gold-500/60 transition-all duration-300 backdrop-blur-sm shadow-2xl hover:shadow-rose-gold-500/20">
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-gradient-to-br from-rose-gold-500 to-rose-gold-600 rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                <Clock class="w-7 h-7 text-luxury-black-900" />
              </div>
            </div>
            <div class="flex-1">
              <h4 class="text-xl font-bold text-rose-gold-500 mb-3">Horario de Atención</h4>
              <div class="space-y-2">
                <div class="flex justify-between items-center text-gray-300">
                  <span class="font-semibold">Lunes - Sábado</span>
                  <span class="text-rose-gold-500 font-bold">10:00 - 20:00</span>
                </div>
                <div class="flex justify-between items-center text-gray-400">
                  <span>Domingos</span>
                  <span class="text-gray-500">Cerrado</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tarjeta de contacto rápido -->
        <div class="group bg-gradient-to-br from-luxury-black-900/90 to-luxury-black-800/90 p-8 rounded-2xl border-2 border-rose-gold-500/30 hover:border-rose-gold-500/60 transition-all duration-300 backdrop-blur-sm shadow-2xl hover:shadow-rose-gold-500/20">
          <div class="flex items-start space-x-4 mb-6">
            <div class="flex-shrink-0">
              <div class="w-14 h-14 bg-gradient-to-br from-rose-gold-500 to-rose-gold-600 rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                <Phone class="w-7 h-7 text-luxury-black-900" />
              </div>
            </div>
            <div class="flex-1">
              <h4 class="text-xl font-bold text-rose-gold-500 mb-2">Llámanos</h4>
              <a href="tel:+528333387811" class="text-2xl font-bold text-gray-200 hover:text-rose-gold-500 transition">
                (833) 338-7811
              </a>
            </div>
          </div>

          <!-- Botones de acción -->
          <div class="grid grid-cols-2 gap-3 pt-4 border-t-2 border-rose-gold-500/20">
            <a
              href="tel:+528333387811"
              class="flex items-center justify-center space-x-2 bg-rose-gold-500/10 hover:bg-rose-gold-500/20 text-rose-gold-500 px-4 py-3 rounded-lg font-semibold border-2 border-rose-gold-500/30 hover:border-rose-gold-500/60 transition-all"
            >
              <Phone class="w-4 h-4" />
              <span class="text-sm">Llamar</span>
            </a>
            <a
              href="https://wa.me/528333387811?text=Hola,%20me%20gustaría%20agendar%20una%20cita"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center space-x-2 bg-green-500/10 hover:bg-green-500/20 text-green-400 px-4 py-3 rounded-lg font-semibold border-2 border-green-500/30 hover:border-green-500/60 transition-all"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span class="text-sm">WhatsApp</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Mapa de Google Maps -->
      <div class="lg:col-span-3">
        <div class="sticky top-8">
          <div class="bg-gradient-to-br from-luxury-black-900/90 to-luxury-black-800/90 p-3 rounded-2xl border-2 border-rose-gold-500/30 shadow-2xl backdrop-blur-sm">
            <div class="rounded-xl overflow-hidden h-[600px] lg:h-[700px] relative group">
              <!-- Google Maps Embed -->
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3724.373753788765!2d-97.89609262596166!3d22.305388179640873!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85d7fbc101d9e49d%3A0xa06d333b084f54fb!2sEmiliano%20Zapata%20229%2C%20La%20Paz%2C%2089326%20Tampico%2C%20Tamps.!5e0!3m2!1ses!2smx!4v1735173600000!5m2!1ses!2smx"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Ubicación de Gamir Salon"
                class="w-full h-full"
              ></iframe>

              <!-- Overlay con botón de navegación -->
              <div class="absolute bottom-4 right-4">
                <a
                  href="https://www.google.com/maps/dir/?api=1&destination=Emiliano+Zapata+229+Colonia+La+Paz+Tampico+Tamaulipas"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center space-x-2 bg-gradient-to-r from-rose-gold-500 to-rose-gold-600 text-luxury-black-900 px-6 py-3 rounded-xl font-bold hover:from-rose-gold-600 hover:to-rose-gold-700 transition-all transform hover:scale-105 shadow-2xl"
                >
                  <Navigation class="w-5 h-5" />
                  <span>Cómo Llegar</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
